{
  "name": "coast-wright",
  "version": "0.0.6-alpha.1",
  "description": "Draw GeoJSON coastlines: seam-aware, projection-agnostic coastline rendering to a canvas, with no dependencies",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./decode": "./lib/decode.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "build:demo": "node scripts/build-demo.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "coastlines": "^0.0.1-alpha.0",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=20.1.0"
  },
  "keywords": [
    "coastline",
    "canvas",
    "map",
    "polyline",
    "geojson",
    "natural-earth",
    "marine",
    "signalk"
  ],
  "license": "MIT",
  "author": "Mark Brannan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark-brannan/coast-wright.git"
  },
  "files": [
    "lib",
    "LICENSE"
  ]
}
